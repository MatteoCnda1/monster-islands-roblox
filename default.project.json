{
  "name": "MonsterIslands",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.4, 0.4, 0.4],
        "Brightness": 2,
        "GlobalShadows": true,
        "ClockTime": 14
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    }
  }
}
